{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "sortImports": {},
  "sortTailwindcss": {
    "stylesheet": "./packages/ui/src/styles/globals.css",
    "functions": ["cn", "cva"]
  },
  "sortPackageJson": true,
  "ignorePatterns": [
    "**/node_modules",
    "**/.next",
    "**/.turbo",
    "**/dist",
    "**/playwright-report",
    "**/test-results",
    "bun.lock",
    "**/next-env.d.ts"
  ]
}
