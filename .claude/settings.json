{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run check)",
      "Bash(bun run lint)",
      "Bash(bun run lint:fix)",
      "Bash(bun run format)",
      "Bash(bun run format:check)",
      "Bash(bun run typecheck)",
      "Bash(bun run test)",
      "Bash(bun run test:e2e)",
      "Bash(bun run build)",
      "Bash(bun test *)",
      "Bash(bunx oxlint *)",
      "Bash(bunx oxfmt *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --no-verify *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude/quiet-commands.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude/post-edit.sh",
            "timeout": 60,
            "statusMessage": "oxfmt + oxlint"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "next-js-base": {
      "source": {
        "source": "directory",
        "path": "./.claude/marketplace"
      }
    }
  },
  "enabledPlugins": {
    "typescript-7-lsp@next-js-base": true
  }
}
