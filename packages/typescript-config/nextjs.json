{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Next.js app",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2023"
    ],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowImportingTsExtensions": true
  }
}
