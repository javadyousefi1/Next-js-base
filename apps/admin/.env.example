# Copy to `.env.local` (`bun run setup` does it for you). Every key is validated at build/boot time.

# --- Public (inlined into the client bundle at build time) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only `true` in the real production deployment. Anything else sends `noindex` everywhere.
NEXT_PUBLIC_SITE_INDEXABLE=false

# --- Server only ---
# Upstream REST API (DummyJSON-compatible contract).
API_BASE_URL=https://api.example.test
# `enabled` → requests to API_BASE_URL are answered by MSW + Faker (src/mocks). Set `disabled`
# and point API_BASE_URL to your real backend when it exists.
API_MOCKING=enabled
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=admin:
# Defaults to `true` in production. Set `false` only when serving production over plain http.
# AUTH_COOKIE_SECURE=true
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
