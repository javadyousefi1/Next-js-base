# Production values for the Docker image (scripts/docker-image.sh reads NEXT_PUBLIC_* from here at
# build time). Committed on purpose: no secrets here. Temporarily the same as `.env.local`.

# --- Public (inlined into the client bundle at build time) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# --- Server only ---
# Back-office REST API (every request carries the header `back-office: true`).
API_BASE_URL=http://5.159.49.104:5001
# `enabled` → requests to API_BASE_URL are answered by MSW (src/mocks), no backend needed.
# Set `disabled` to use the real API.
API_MOCKING=enabled
# Defaults to `true` in production. Set `false` only when serving production over plain http.
# AUTH_COOKIE_SECURE=true
# Cookie lifetime when the JWT has no `exp` claim.
AUTH_TOKEN_TTL_SECONDS=86400
