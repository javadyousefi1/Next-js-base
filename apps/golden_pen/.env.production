# Production values for the server. Used twice:
# - build time: scripts/docker-image.sh bakes the NEXT_PUBLIC_* values into the image;
# - run time: `docker run --env-file .env.production` (the server variables below).
# Committed on purpose: no secrets here.

# --- Public (inlined into the client bundle at build time) ---
# Where the panel is served (same server as the backend, port 3002).
NEXT_PUBLIC_SITE_URL=http://5.159.49.104:3002

# --- Server only ---
# The real back-office API (every request carries the header `back-office: true`).
API_BASE_URL=http://5.159.49.104:5001
# The real API, never the built-in mock.
API_MOCKING=disabled
# The panel is served over plain http (no domain/TLS yet): the login cookie must not be `Secure`,
# browsers drop those on http. (Already the default for an http NEXT_PUBLIC_SITE_URL.)
AUTH_COOKIE_SECURE=false
# Cookie lifetime when the JWT has no `exp` claim.
AUTH_TOKEN_TTL_SECONDS=86400
