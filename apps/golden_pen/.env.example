# Copy to `.env.local` (`bun run setup` does it for you). Every key is validated at build/boot time.

# --- Public (inlined into the client bundle at build time) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# --- Server only ---
# Back-office REST API (every request carries the header `back-office: true`).
API_BASE_URL=http://5.159.49.104:5001
# `disabled` → the real API above. `enabled` → answered by MSW (src/mocks), no backend needed
# (demo login 09120000000 / admin123, SMS code 123456; the e2e tests always use it).
API_MOCKING=disabled
# Defaults to `true` when NEXT_PUBLIC_SITE_URL is https, `false` when it is http.
# AUTH_COOKIE_SECURE=true
# Cookie lifetime when the JWT has no `exp` claim.
AUTH_TOKEN_TTL_SECONDS=86400
